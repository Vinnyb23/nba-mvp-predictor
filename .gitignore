# NBA MVP Predictor
# Files and folders excluded from version control.

# Python bytecode and cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and application secrets
.env
.env.*
.streamlit/secrets.toml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Test, coverage, and static-analysis output
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Local data files
# Keep .gitkeep files so the folder structure remains in GitHub.
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained-model artifacts
models/*.joblib
models/*.pkl
models/*.pickle

# Logs and temporary output
*.log
tmp/
temp/

# Operating-system files
.DS_Store
Thumbs.db

# IDE and editor settings
.vscode/
.idea/
